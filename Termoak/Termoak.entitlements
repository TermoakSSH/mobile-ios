<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: https://termoak.com/join/<token> (and the staging
	     server's) open the app. The servers publish the matching
	     /.well-known/apple-app-site-association with the Team ID of
	     Signing.xcconfig (scripts/apple-app-site-association.sh). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:termoak.com</string>
		<string>applinks:next.termoak.com</string>
	</array>
</dict>
</plist>
