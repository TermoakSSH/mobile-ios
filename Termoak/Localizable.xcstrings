    "two_factor.explain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in also asks for a code from an authenticator app (or a recovery code), so your password alone is not enough."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al iniciar sesión también se pide un código de una app de autenticación (o un código de recuperación), así que tu contraseña sola no basta."
          }
        }
      }
    },
    "two_factor.off_hint": {
      "localizations": {
