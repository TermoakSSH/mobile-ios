{
  "sourceLanguage": "en",
  "strings": {
    "account.session_expired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session has expired: log in again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión ha caducado: vuelve a iniciar sesión"
          }
        }
      }
    },
    "accounts.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add account"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir cuenta"
          }
        }
      }
    },
    "accounts.all": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All accounts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las cuentas"
          }
        }
      }
