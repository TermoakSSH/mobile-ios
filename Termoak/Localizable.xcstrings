    "two_factor.recovery_footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save them somewhere safe: each one signs you in once if you lose your authenticator app. They are not shown again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guárdalos en un lugar seguro: cada uno sirve una vez para iniciar sesión si pierdes tu app de autenticación. No se vuelven a mostrar."
          }
        }
      }
    },
