    "accounts.unsynced.discard": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard and sign out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar y cerrar sesión"
          }
        }
      }
    },
    "accounts.unsynced.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you sign out now they are lost, and the account's data on this device is deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cierras sesión ahora se pierden, y se borran los datos de la cuenta en este dispositivo."
          }
        }
      }
    },
    "accounts.unsynced.sync": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync now and sign out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar y cerrar sesión"
          }
        }
      }
    },
    "accounts.unsynced.title %lld": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld change is not uploaded yet"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld changes are not uploaded yet"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld cambio aún no se ha subido"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld cambios aún no se han subido"
                }
              }
            }
          }
        }
      }
    },
    "activity.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load the activity"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la actividad"
          }
        }
      }
    },
    "activity.from %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "from %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "desde %@"
          }
        }
      }
    },
    "activity.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who typed and when, counted from the start of the recording. Only who and when is kept, not what was typed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quién escribió y cuándo, contado desde el inicio de la grabación. Solo se guarda quién y cuándo, no lo que se escribió."
          }
        }
      }
    },
    "activity.kind.ai": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IA"
          }
        }
      }
    },
    "activity.menu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity: who typed"
          }
        },
        "es": {
