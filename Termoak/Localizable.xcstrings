    "gestures.button.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A button on the key bar (and at the top) switches one finger between moving the cursor and scrolling. With the cursor active, two fingers scroll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un botón en la barra de teclas (y arriba) cambia un dedo entre mover el cursor y desplazar. Con el cursor activo, dos dedos desplazan."
          }
        }
      }
    },
    "gestures.button.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a button"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con botón"
          }
        }
      }
    },
    "gestures.hold.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiping scrolls the terminal. Hold for a moment and drag to move the cursor; hold still to copy and paste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizar desplaza el terminal. Mantén pulsado un momento y arrastra para mover el cursor; mantén quieto para copiar y pegar."
          }
        }
      }
    },
    "gestures.hold.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold and drag"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener y arrastrar"
          }
        }
      }
    },
    "gestures.off.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiping only scrolls the terminal."
