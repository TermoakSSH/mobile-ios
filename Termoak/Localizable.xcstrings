    "accounts.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each account keeps its own vaults, server sessions and AI. Hosts saved on This device stay here whatever account you use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cuenta tiene sus vaults, sesiones en el servidor e IA. Los hosts guardados en Este dispositivo se quedan aquí uses la cuenta que uses."
          }
        }
      }
    },
    "accounts.layout_notice.accounts %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Termoak can now use several accounts at once. What was synced with your server is now in the account %@; what was only on this device is under This device. A copy of the previous data is kept for 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termoak ya puede usar varias cuentas a la vez. Lo que se sincronizaba con tu servidor está ahora en la cuenta %@; lo que solo estaba en este dispositivo está en Este dispositivo. Se guarda una copia de los datos anteriores durante 30 días."
          }
        }
      }
    },
    "accounts.layout_notice.device": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Termoak can now use several accounts at once. Your hosts, keys and snippets are under This device. A copy of the previous data is kept for 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termoak ya puede usar varias cuentas a la vez. Tus hosts, claves y snippets están en Este dispositivo. Se guarda una copia de los datos anteriores durante 30 días."
          }
        }
      }
    },
    "accounts.layout_notice.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data was reorganized"
          }
        },
        "es": {
          "stringUnit": {
