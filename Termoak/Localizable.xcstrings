    "tunnels.empty.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tunnel takes a port on this device to a service on the server (or the other way round), encrypted over SSH. For example, a database that only listens on the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un túnel lleva un puerto de este dispositivo a un servicio del servidor (o al revés), cifrado por SSH. Por ejemplo, una base de datos que solo escucha en el servidor."
          }
        }
      }
    },
    "tunnels.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tunnels"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin túneles"
          }
        }
      }
    },
    "tunnels.error.destination_port": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The destination port is missing (1–65535)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el puerto de destino (1–65535)."
          }
        }
      }
    },
    "tunnels.error.listen_port": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The listening port must be a number between 1 and 65535."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puerto de escucha debe ser un número entre 1 y 65535."
          }
        }
      }
    },
    "tunnels.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS freezes the app shortly after you leave it: local tunnels work while the app is open and for a few minutes after. Those marked as automatic start when a terminal connects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS congela la app al poco de salir de ella: los túneles locales funcionan con la app abierta y unos minutos después. Los marcados como automáticos arrancan al conectar un terminal."
          }
        }
      }
    },
    "tunnels.kind.dynamic.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A SOCKS5 proxy on this device that goes out to the internet through the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un proxy SOCKS5 en este dispositivo que sale a internet a través del servidor."
          }
        }
      }
    },
    "tunnels.kind.local": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Local"
          }
        }
      }
    },
    "tunnels.kind.local.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A port on this device leads to a service the server can reach (e.g. its database on localhost:5432)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un puerto de este dispositivo lleva a un servicio al que llega el servidor (p. ej. su base de datos en localhost:5432)."
          }
        }
      }
    },
    "tunnels.kind.remote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Remoto"
          }
        }
      }
    },
    "tunnels.kind.remote.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A port on the server leads to a service this device can reach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un puerto del servidor lleva a un servicio al que llega este dispositivo."
          }
        }
      }
    },
