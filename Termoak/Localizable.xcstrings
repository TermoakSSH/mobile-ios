        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict: Use-only members connect only through the server, so passwords and keys never reach their devices (no local tunnels)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estricto: los miembros de Solo uso solo se conectan a través del servidor, así las contraseñas y claves nunca llegan a sus dispositivos (sin túneles locales)."
          }
        }
      }
    },
