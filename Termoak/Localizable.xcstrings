    "accounts.sign_out": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar sesión"
          }
        }
      }
    },
    "accounts.sign_out.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing out deletes this account's data from this device (it stays on the server). Other accounts and This device items are not touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cerrar sesión se borran los datos de esta cuenta en este dispositivo (siguen en el servidor). Las demás cuentas y los elementos de Este dispositivo no se tocan."
          }
        }
      }
    },
    "accounts.sign_out.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account's hosts, keys and snippets are deleted from this device. They stay on the server: sign in again to get them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hosts, claves y snippets de la cuenta se borran de este dispositivo. Siguen en el servidor: vuelve a iniciar sesión para recuperarlos."
          }
        }
      }
    },
