    "vaults.member.remove.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They lose access at once: the vault's items are removed from their devices and their server sessions on its hosts close."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierde el acceso al momento: los elementos del vault se quitan de sus dispositivos y se cierran sus sesiones en el servidor con sus hosts."
          }
        }
      }
    },
