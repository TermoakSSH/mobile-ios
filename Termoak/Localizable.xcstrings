    "terminal.host_key.forget_message %@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved key: %1$@\nKey now: %2$@\n\nDo this only if you know why it changed (the server was reinstalled or got a new key). Otherwise someone could be impersonating it. You'll be asked to trust the new fingerprint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave guardada: %1$@\nClave ahora: %2$@\n\nHazlo solo si sabes por qué ha cambiado (se reinstaló el servidor o tiene una clave nueva). Si no, alguien podría estar suplantándolo. Se te preguntará si confías en la huella nueva."
          }
        }
      }
    },
    "terminal.host_key.forget_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget the old key and connect again?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Olvidar la clave antigua y volver a conectar?"
          }
        }
