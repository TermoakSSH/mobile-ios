    "host_editor.credentials.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a key or an identity of the keychain no password is needed. Without any, it is asked for when connecting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una clave o una identidad del llavero no hace falta contraseña. Sin ninguna, se pide al conectar."
          }
        }
      }
    },
