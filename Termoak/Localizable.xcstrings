        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks for your permission before any change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te pide permiso antes de cualquier cambio."
          }
        }
      }
    },
    "ai.mode.auto": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autonomous"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autónomo"
          }
        }
      }
    },
    "ai.mode.auto.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Makes changes without asking. Use it with care."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace los cambios sin preguntar. Úsalo con cuidado."
          }
        }
      }
    },
    "ai.mode.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always ask"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar siempre"
          }
        }
      }
    },
    "ai.mode.confirm.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks for your permission for everything it runs on a host, even if it only reads."
          }
        },
        "es": {
