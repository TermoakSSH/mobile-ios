    "accounts.sync.discarded %lld %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@: %#@changes@"
          },
          "substitutions": {
            "changes": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg unsynced change was discarded"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg unsynced changes were discarded"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@: %#@changes@"
          },
          "substitutions": {
            "changes": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "se descartó %arg cambio sin sincronizar"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "se descartaron %arg cambios sin sincronizar"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "accounts.sync.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronización"
          }
        }
      }
    },
    "accounts.sync.vaults_added %@": {
      "localizations": {
