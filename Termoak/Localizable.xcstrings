    "vaults.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server has no vaults: update it to share hosts with people and teams."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor no tiene vaults: actualízalo para compartir hosts con personas y equipos."
          }
        }
      }
    },
    "vaults.use_only.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can connect to its hosts; their passwords and keys are fetched from the server just for the connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes conectarte a sus hosts; sus contraseñas y claves se piden al servidor solo para la conexión."
          }
        }
      }
    },
    "vaults.use_only.strict_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You connect to its hosts through the server: tapping one opens a server session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te conectas a sus hosts a través del servidor: al tocar uno se abre una sesión en el servidor."
          }
        }
      }
    },
