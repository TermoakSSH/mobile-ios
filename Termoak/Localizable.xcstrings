    "activity.not_recorded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session was not recorded, so there is no record of who typed and when."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión no se grabó, así que no hay registro de quién escribió ni cuándo."
          }
        }
      }
    },
    "activity.recorded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
