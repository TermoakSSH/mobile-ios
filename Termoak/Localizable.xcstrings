    "host_editor.connection": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión"
          }
        }
      }
    },
    "host_editor.connection.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent forwarding lets the server use your keys to connect further; turn it on only for servers you trust. Keep-alive sends a signal every so many seconds so idle connections are not cut (0: off). Recording applies to the sessions on the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reenvío del agente deja que el servidor use tus claves para conectarse a otros; actívalo solo en servidores de confianza. El keep-alive envía una señal cada tantos segundos para que no se corten las conexiones inactivas (0: desactivado). La grabación se aplica a las sesiones en el servidor."
          }
        }
      }
    },
    "host_editor.credentials": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
