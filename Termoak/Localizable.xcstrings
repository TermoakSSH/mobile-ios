      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use-only members connect to the hosts but never see their passwords or keys, and cannot change anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los miembros de Solo uso se conectan a los hosts pero nunca ven sus contraseñas ni claves, y no pueden cambiar nada."
          }
        }
      }
    },
    "vaults.roles.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor: sees and changes everything. Use only: connects without seeing passwords or keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor: ve y cambia todo. Solo uso: se conecta sin ver contraseñas ni claves."
