{
  "sourceLanguage": "en",
  "strings": {
    "account.session_expired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session has expired: log in again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión ha caducado: vuelve a iniciar sesión"
          }
        }
      }
    },
    "ai.always": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre"
          }
        }
      }
    },
    "ai.approve_always": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always approve"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobar siempre"
          }
        }
      }
    },
    "ai.empty.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in to your server to start tasks, follow them and approve what the AI wants to do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en tu servidor para lanzar tareas, seguirlas y aprobar lo que la IA quiera hacer."
          }
        }
      }
    },
    "ai.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI lives on the server"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA vive en el servidor"
          }
        }
      }
    },
    "ai.error.budget_exceeded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month's AI credit is used up. Add your own API key in Settings → AI to keep going."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha agotado el crédito de IA de este mes. Añade tu propia clave de API en Ajustes → IA para seguir."
          }
        }
      }
    },
    "ai.error.key_required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan doesn't include the server's AI. Add your own API key in Settings → AI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu plan no incluye la IA del servidor. Añade tu propia clave de API en Ajustes → IA."
          }
        }
      }
    },
    "ai.error.open_settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open AI settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ajustes de IA"
          }
        }
      }
    },
    "ai.mode.ask": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask"
          }
        },
        "es": {
