    "settings.wide_layout.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic: the desktop layout (tabs on top and a sidebar) on an iPad with a wide window. Desktop layout: also on an iPhone Plus or Pro Max in landscape. Narrow windows always use the phone layout. Open terminals stay connected when the layout changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático: el diseño de escritorio (pestañas arriba y barra lateral) en un iPad con la ventana ancha. Diseño de escritorio: también en un iPhone Plus o Pro Max en horizontal. Las ventanas estrechas siempre usan el diseño de teléfono. Los terminales abiertos siguen conectados al cambiar de diseño."
          }
        }
      }
    },
